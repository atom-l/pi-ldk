{
  "name": "ldk",
  "version": "0.3.0",
  "description": "LDK — a PI package bundling custom extensions (session commands, model attribution, MCP adapter, image generation, embedded terminal).",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "extensions",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/mcp-adapter.ts",
      "./extensions/model-attribution.ts",
      "./extensions/sessions.ts",
      "./extensions/image-gen",
      "./extensions/session-agents",
      "./extensions/terminal"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}