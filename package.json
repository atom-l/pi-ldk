{
  "name": "ldk",
  "version": "0.23.0",
  "description": "LDK — a PI package bundling custom extensions (session commands, model attribution, MCP adapter, image generation, embedded terminal, session working directory, styled footer, session agents, named flows and actions, interactive reply forms).",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "extensions",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/mcp-adapter.ts",
      "./extensions/loop-guard",
      "./extensions/model-attribution.ts",
      "./extensions/sessions.ts",
      "./extensions/image-gen",
      "./extensions/session-agents",
      "./extensions/flow",
      "./extensions/reply-form",
      "./extensions/terminal",
      "./extensions/markdown-editor",
      "./extensions/workdir.ts",
      "./extensions/styled-footer.ts"
    ]
  },
  "dependencies": {
    "iconv-lite": "^0.7.3"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.7.0",
    "@earendil-works/pi-ai": "1.7.0",
    "@earendil-works/pi-coding-agent": "1.7.0",
    "@earendil-works/pi-tui": "1.7.0",
    "typebox": "1.3.27"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
